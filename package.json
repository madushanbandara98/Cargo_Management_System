{
  "name": "cargo-management-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web migration of the Cargo Management System",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/start.js",
    "build": "vite build",
    "build:native": "vite build --mode native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "preview": "vite preview",
    "start": "node server/start.js",
    "check": "node --check server/index.js && node --check server/start.js && node --check api/index.js && node --check server/db.js && node --check server/mongo/connection.js && node --check server/mongo/models.js && node --check server/tracking/providers.js && node --check scripts/migrate-to-mongo.js && node --check scripts/reset-admin-password.js && node --check public/app.js",
    "reset-admin-password": "node scripts/reset-admin-password.js",
    "migrate:mongo": "node scripts/migrate-to-mongo.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.5"
  }
}
