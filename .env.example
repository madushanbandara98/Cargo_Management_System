PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/cargo_management?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
# Optional: overrides the database name contained in MONGODB_URI
# MONGODB_DB=cargo_management

# Used only by the one-time local SQLite migration. Vercel does not use it.
DATABASE_PATH=./data/cargo-web.db

# Resend transactional email (server-side only)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Madushan Cargo <invoices@your-verified-domain.com>

# Shipment tracking. Use manual until a production API provider is configured.
TRACKING_PROVIDER=manual
# Required before accepting provider webhook calls. Generate with: openssl rand -hex 32
TRACKING_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# A production adapter may additionally require its own API key or OAuth credentials.
# TRACKING_API_KEY=
